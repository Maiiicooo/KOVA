{
  "appId": "app.kova.spot",
  "appName": "KOVA",
  "webDir": "www",
  "backgroundColor": "#0b0b0b",
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SystemBars": { "style": "DARK", "hidden": false, "insetsHandling": "css" },
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 1500,
      "backgroundColor": "#0b0b0b",
      "showSpinner": false
    }
  }
}
